APP_NAME=WeChat Character Lab API
DATABASE_URL=sqlite:///../data/character_lab.db
INBOX_PATH=data/inbox
LOG_LEVEL=INFO

# Semantic analysis is disabled unless both switches are explicitly enabled.
SEMANTIC_LLM_ENABLED=false
SEMANTIC_LLM_ALLOW_MESSAGE_CONTENT=false
SEMANTIC_LLM_ENDPOINT=
SEMANTIC_LLM_MODEL=
SEMANTIC_LLM_API_KEY=
SEMANTIC_LLM_TIMEOUT_SECONDS=30
SEMANTIC_LLM_MAX_INPUT_CHARS=100000
