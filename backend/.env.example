APP_NAME=WeChat Character Lab API
DATABASE_URL=sqlite:///../data/character_lab.db
INBOX_PATH=data/inbox
LOG_LEVEL=INFO

# Optional SEMANTIC_LLM_* values, when explicitly set, override UI-managed
# Provider settings. These fields default to disabled in app configuration.
# Uncomment only values intentionally managed by the process environment.
# Target defaults (verify provider support before use):
# SEMANTIC_LLM_ENDPOINT=https://api.deepseek.com
# SEMANTIC_LLM_MODEL=deepseek-v4-pro
# SEMANTIC_LLM_ENABLED=false
# SEMANTIC_LLM_ALLOW_MESSAGE_CONTENT=false
# SEMANTIC_LLM_API_KEY=
# SEMANTIC_LLM_TIMEOUT_SECONDS=30
# SEMANTIC_LLM_MAX_INPUT_CHARS=100000
